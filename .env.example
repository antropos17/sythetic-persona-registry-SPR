# Local development. Copy to .env only if needed; Node does not load it automatically.
HOST=127.0.0.1
PORT=4176
SPR_DB_PATH=./var/spr.sqlite
# Set the exact public HTTPS origin when deployed behind a proxy.
# PUBLIC_ORIGIN=https://registry.example.com
# Optional local review console. Generate a unique 32-byte random token and
# pass it through the process environment or a secret manager. Never commit it.
# SPR_REVIEWER_TOKEN=<generated secret>
